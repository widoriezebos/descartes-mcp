<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.bitsapplied.descartes</groupId>
  <artifactId>descartes-mcp</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>descartes-mcp</name>
  <description>MCP server for java. Deep introspection and REPL out of the box</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  	<dependencies>
		<dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>0.11.1</version>
        </dependency>
        <dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
			<version>2.24.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>2.24.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-slf4j2-impl</artifactId>
			<version>2.24.1</version>
		</dependency>
        		<!-- TEST SCOPE -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<version>5.15.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-inline</artifactId>
			<version>5.2.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.11.3</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.11.3</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-suite-engine</artifactId>
			<version>1.11.3</version>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>5.15.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>3.26.3</version>
			<scope>test</scope>
		</dependency>

		<!-- ASM for bytecode analysis -->
		<dependency>
			<groupId>org.ow2.asm</groupId>
			<artifactId>asm</artifactId>
			<version>9.7</version>
		</dependency>

		<!-- RxJava for reactive event processing (debugger) -->
		<dependency>
			<groupId>io.reactivex.rxjava3</groupId>
			<artifactId>rxjava</artifactId>
			<version>3.1.8</version>
		</dependency>

		<!-- Janino for expression compilation (debugger) -->
		<dependency>
			<groupId>org.codehaus.janino</groupId>
			<artifactId>janino</artifactId>
			<version>3.1.11</version>
		</dependency>

  	</dependencies>

	<build>
		<!-- Set the final artifact name to include the timestamp -->
		<finalName>descartes-mcp-${timestamp}</finalName>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
				<filtering>false</filtering>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>set-timestamp</id>
						<phase>validate</phase>
						<goals>
							<goal>timestamp-property</goal>
						</goals>
						<configuration>
							<!-- This sets the property 'timestamp' with the current build timestamp -->
							<name>timestamp</name>
							<pattern>yyyyMMdd-HHmmss</pattern>
							<!-- Use English locale to avoid platform-dependent formatting -->
							<locale>en_US</locale>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Compiler Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<source>21</source>
					<target>21</target>
				</configuration>
			</plugin>

			<!-- Source Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.1.0</version>
				<extensions>false</extensions>
				<inherited>true</inherited>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Exec Plugin -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<mainClass>com.bitsapplied.descartes.example.SimpleMCPServerExample</mainClass>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<encoding>UTF-8</encoding>
					<propertiesEncoding>UTF-8</propertiesEncoding>
				</configuration>
			</plugin>

			<!-- Assembly Plugin with Agent Support -->
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.7.1</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>com.bitsapplied.descartes.example.SimpleMCPServerExample</mainClass>
						</manifest>
						<manifestEntries>
							<!-- Java Agent manifest entries for hot reload -->
							<Premain-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Premain-Class>
							<Agent-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Agent-Class>
							<Can-Redefine-Classes>true</Can-Redefine-Classes>
							<Can-Retransform-Classes>true</Can-Retransform-Classes>
							<Can-Set-Native-Method-Prefix>false</Can-Set-Native-Method-Prefix>
						</manifestEntries>
					</archive>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- OpenRewrite Plugin -->
			<plugin>
				<groupId>org.openrewrite.maven</groupId>
				<artifactId>rewrite-maven-plugin</artifactId>
				<version>6.21.1</version>
				<configuration>
					<activeRecipes>
						<recipe>org.openrewrite.java.ShortenFullyQualifiedTypeReferences</recipe>
					</activeRecipes>
				</configuration>
			</plugin>

			<!-- Surefire Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
				<configuration>
					<!-- JVM flags required for debugger/hot-reload tests on JDK 21+:
					     -Xshare:off
					       * Disable class-data sharing so that Attach/JDWP can operate in a forked JVM.
					     -XX:+UnlockDiagnosticVMOptions
					       * Mandatory before enabling any diagnostic VM switches (the next flag).
					     -XX:+EnableDynamicAgentLoading
					       * Permits the hot-reload agent to be loaded at runtime; harmless on older JDKs.
					     add-opens jdk.attach/sun.tools.attach=ALL-UNNAMED
					       * Opens the Attach API internals to the test JVM so DebuggeeLauncher can enumerate processes.
					     add-opens jdk.jdi/com.sun.jdi=ALL-UNNAMED
					       * Grants reflective access to public JDI interfaces that are encapsulated by JPMS.
					     add-opens jdk.jdi/com.sun.tools.jdi=ALL-UNNAMED
					       * Exposes the JDI implementation classes required by the debugger.
					     -Xlog:jfr*=off
					       * Suppresses JFR warnings and errors (especially I/O errors from force-stopped recordings).

					     Test infrastructure note:
					     Debugger tests launch a helper JVM (DebuggeeLauncher) that already has JDWP
					     enabled via -agentlib. HotSpot still lacks Agent_OnAttach for JDWP (JDK 11-23),
					     so we can only attach to processes that start with agentlib. -->
					<argLine>-Xshare:off -XX:+UnlockDiagnosticVMOptions -XX:+EnableDynamicAgentLoading --add-opens jdk.attach/sun.tools.attach=ALL-UNNAMED --add-opens jdk.jdi/com.sun.jdi=ALL-UNNAMED --add-opens jdk.jdi/com.sun.tools.jdi=ALL-UNNAMED -Xlog:jfr*=off</argLine>
					<!-- Don't reuse forks to prevent JDWP port collisions from orphaned processes -->
					<reuseForks>false</reuseForks>
					<!-- Redirect test output to files to avoid corrupted channel warnings -->
					<redirectTestOutputToFile>true</redirectTestOutputToFile>
					<includes>
						<include>**/*Test.java</include>
					</includes>
					<excludes>
						<!-- Exclude test suites to avoid running tests twice -->
						<exclude>**/TestSuite.java</exclude>
						<!-- Exclude concurrency test suite and individual concurrency tests -->
						<exclude>**/ConcurrencyTestSuite.java</exclude>
						<exclude>**/*ConcurrencyTest.java</exclude>
						<exclude>**/*ConcurrentTest.java</exclude>
						<!-- Exclude long-running tests (>30 seconds) -->
						<exclude>**/DebuggerEndToEndTest.java</exclude>
						<exclude>**/ProfilerServiceTest.java</exclude>
						<exclude>**/Profiler*ToolTest.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
	    <profile>
           <id>eclipse-m2e</id>
           <activation>
             <property>
               <name>m2e.version</name>
             </property>
           </activation>
           <build>
             <directory>${project.basedir}/target-eclipse</directory>
           </build>
        </profile>
		<!-- Profile to run concurrency tests -->
		<profile>
			<id>concurrency-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.5.2</version>
						<configuration>
							<argLine>-XX:+EnableDynamicAgentLoading</argLine>
							<includes combine.self="override">
								<include>**/ConcurrencyTestSuite.java</include>
								<include>**/JShellToolConcurrencyTest.java</include>
							</includes>
							<!-- Override default excludes to run only concurrency tests -->
							<excludes combine.self="override" />
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile to run all tests including concurrency and hot reload tests -->
		<profile>
			<id>all-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.5.2</version>
						<configuration>
							<argLine>-Xshare:off -XX:+EnableDynamicAgentLoading -javaagent:${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar</argLine>
							<includes combine.self="override">
								<include>**/*Test.java</include>
								<include>**/*TestSuite.java</include>
							</includes>
							<!-- No excludes - run everything -->
							<excludes combine.self="override" />
						</configuration>
					</plugin>
					<!-- Ensure the agent JAR is built before tests -->
					<plugin>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>3.7.1</version>
						<configuration>
							<archive>
								<manifest>
									<mainClass>com.bitsapplied.descartes.example.SimpleMCPServerExample</mainClass>
								</manifest>
								<manifestEntries>
									<!-- Java Agent manifest entries for hot reload -->
									<Premain-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Premain-Class>
									<Agent-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Agent-Class>
									<Can-Redefine-Classes>true</Can-Redefine-Classes>
									<Can-Retransform-Classes>true</Can-Retransform-Classes>
									<Can-Set-Native-Method-Prefix>false</Can-Set-Native-Method-Prefix>
								</manifestEntries>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
						</configuration>
						<executions>
							<execution>
								<id>make-assembly</id>
								<phase>process-test-classes</phase>
								<goals>
									<goal>single</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile to run hot reload tests with agent -->
		<profile>
			<id>hot-reload-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.5.2</version>
						<configuration>
							<argLine>-Xshare:off -XX:+EnableDynamicAgentLoading -javaagent:${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar</argLine>
							<includes combine.self="override">
								<include>**/HotReload*Test.java</include>
								<include>**/Hot*ReloadToolTest.java</include>
							</includes>
							<!-- Override default excludes to run hot reload tests -->
							<excludes combine.self="override" />
						</configuration>
					</plugin>
					<!-- Ensure the agent JAR is built before tests -->
					<plugin>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>3.7.1</version>
						<configuration>
							<archive>
								<manifest>
									<mainClass>com.bitsapplied.descartes.example.SimpleMCPServerExample</mainClass>
								</manifest>
								<manifestEntries>
									<!-- Java Agent manifest entries for hot reload -->
									<Premain-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Premain-Class>
									<Agent-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Agent-Class>
									<Can-Redefine-Classes>true</Can-Redefine-Classes>
									<Can-Retransform-Classes>true</Can-Retransform-Classes>
									<Can-Set-Native-Method-Prefix>false</Can-Set-Native-Method-Prefix>
								</manifestEntries>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
						</configuration>
						<executions>
							<execution>
								<id>make-assembly</id>
								<phase>process-test-classes</phase>
								<goals>
									<goal>single</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile to run long-running tests (>30 seconds) -->
		<profile>
			<id>long-running-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.5.2</version>
						<configuration>
							<!-- Same JVM flags as default profile, required for debugger/profiler tests -->
							<argLine>-Xshare:off -XX:+UnlockDiagnosticVMOptions -XX:+EnableDynamicAgentLoading --add-opens jdk.attach/sun.tools.attach=ALL-UNNAMED --add-opens jdk.jdi/com.sun.jdi=ALL-UNNAMED --add-opens jdk.jdi/com.sun.tools.jdi=ALL-UNNAMED -Xlog:jfr*=off</argLine>
							<!-- Don't reuse forks to prevent JDWP port collisions -->
							<reuseForks>false</reuseForks>
							<!-- Redirect test output to files -->
							<redirectTestOutputToFile>true</redirectTestOutputToFile>
							<includes combine.self="override">
								<!-- Debugger end-to-end test (~82s) -->
								<include>**/DebuggerEndToEndTest.java</include>
								<!-- Profiler tests (~40-82s each) -->
								<include>**/ProfilerServiceTest.java</include>
								<include>**/Profiler*ToolTest.java</include>
							</includes>
							<!-- Override default excludes to run only long-running tests -->
							<excludes combine.self="override" />
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile to run the example server with hot reload agent -->
		<profile>
			<id>run-with-agent</id>
			<build>
				<plugins>
					<!-- First ensure the agent JAR is built -->
					<plugin>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>3.7.1</version>
						<executions>
							<execution>
								<phase>compile</phase>
								<goals>
									<goal>single</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
							<finalName>${project.artifactId}-${project.version}</finalName>
							<appendAssemblyId>true</appendAssemblyId>
							<attach>false</attach>
							<archive>
								<manifest>
									<mainClass>com.bitsapplied.descartes.example.SimpleMCPServerExample</mainClass>
								</manifest>
								<manifestEntries>
									<Premain-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Premain-Class>
									<Agent-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Agent-Class>
									<Can-Redefine-Classes>true</Can-Redefine-Classes>
									<Can-Retransform-Classes>true</Can-Retransform-Classes>
								</manifestEntries>
							</archive>
						</configuration>
					</plugin>
					
					<!-- Run the example with the agent using exec:exec to launch new JVM -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<goals>
									<goal>exec</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<executable>java</executable>
							<arguments>
								<!-- JVM flags -->
								<argument>-XX:+EnableDynamicAgentLoading</argument>
								<argument>-Xshare:off</argument>
								<argument>-javaagent:${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>
								<!-- System properties -->
								<argument>-Ddescartes.continuous=true</argument>
								<!-- Classpath -->
								<argument>-cp</argument>
								<argument>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>
								<!-- Main class -->
								<argument>com.bitsapplied.descartes.example.SimpleMCPServerExample</argument>
								<!-- Program arguments -->
								<argument>--continuous</argument>
							</arguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile to run the remote debug proxy -->
		<profile>
			<id>run-remote-proxy</id>
			<build>
				<plugins>
					<!-- First ensure the JAR is built -->
					<plugin>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>3.7.1</version>
						<executions>
							<execution>
								<phase>compile</phase>
								<goals>
									<goal>single</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
							<finalName>${project.artifactId}-${project.version}</finalName>
							<appendAssemblyId>true</appendAssemblyId>
							<attach>false</attach>
							<archive>
								<manifest>
									<mainClass>com.bitsapplied.descartes.debugger.MCPRemoteDebugProxy</mainClass>
								</manifest>
								<manifestEntries>
									<Premain-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Premain-Class>
									<Agent-Class>com.bitsapplied.descartes.hotreload.agent.HotReloadAgent</Agent-Class>
									<Can-Redefine-Classes>true</Can-Redefine-Classes>
									<Can-Retransform-Classes>true</Can-Retransform-Classes>
								</manifestEntries>
							</archive>
						</configuration>
					</plugin>

					<!-- Run the remote proxy using exec:exec to launch new JVM -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<goals>
									<goal>exec</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<executable>java</executable>
							<arguments>
								<!-- JVM flags for JDK 17+ -->
								<argument>--add-opens</argument>
								<argument>jdk.attach/sun.tools.attach=ALL-UNNAMED</argument>
								<!-- Classpath -->
								<argument>-cp</argument>
								<argument>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>
								<!-- Main class -->
								<argument>com.bitsapplied.descartes.debugger.MCPRemoteDebugProxy</argument>
								<!-- Program arguments (pass through system properties) -->
								<argument>--jdwp-host</argument>
								<argument>${descartes.jdwp.host}</argument>
								<argument>--jdwp-port</argument>
								<argument>${descartes.jdwp.port}</argument>
								<argument>--mcp-port</argument>
								<argument>${descartes.mcp.port}</argument>
							</arguments>
							<systemProperties>
								<systemProperty>
									<key>descartes.jdwp.host</key>
									<value>${descartes.jdwp.host}</value>
								</systemProperty>
								<systemProperty>
									<key>descartes.jdwp.port</key>
									<value>${descartes.jdwp.port}</value>
								</systemProperty>
								<systemProperty>
									<key>descartes.mcp.port</key>
									<value>${descartes.mcp.port}</value>
								</systemProperty>
							</systemProperties>
						</configuration>
					</plugin>
				</plugins>
			</build>
			<properties>
				<!-- Default values for system properties -->
				<descartes.jdwp.host>localhost</descartes.jdwp.host>
				<descartes.jdwp.port>5005</descartes.jdwp.port>
				<descartes.mcp.port>9090</descartes.mcp.port>
			</properties>
		</profile>

	</profiles>

</project>
